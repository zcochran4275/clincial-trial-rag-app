# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5             # any tool-calling chat model
OPENFDA_API_KEY=            # free: https://open.fda.gov/apis/authentication/

# Databricks Free Edition (Settings > Developer > Access tokens)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_HTTP_PATH=       # SQL warehouse > Connection details
DATABRICKS_WAREHOUSE_ID=    # the last segment of the HTTP path
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=trial_signal
